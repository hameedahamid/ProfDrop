@{
    ViewData["Title"] = "Feedback Submitted";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">

                    @* Confirm that the feedback was submitted successfully *@
                    <h1 class="mb-3">Feedback Submitted</h1>

                    <p class="text-muted mb-4">
                        Thank you for your feedback. Your response has been submitted anonymously.
                    </p>

                    @* Allow the student to submit another response *@  
                    <a asp-controller="Feedback"
                       asp-action="Index"
                       class="btn btn-primary">
                        Submit More Feedback
                    </a>

                    @* Return the student to the home page *@
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Back to Home
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
