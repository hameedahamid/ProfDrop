@model ProfDropMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Lecturer Dashboard";
}

@* Display the lecturer's profile details *@
<div class="lecturer-profile mb-4">

    @* Show the lecturer's profile image if one exists *@
    @if (!string.IsNullOrWhiteSpace(Model.ProfileUrl))
    {
        <img src="@Model.ProfileUrl"
             alt="@Model.Name"
             class="lecturer-dashboard-photo" />
    }

    @* Show the lecturer's name, email and dashboard message *@
    <div>
        <h1 class="mb-1">Welcome, @Model.Name 👋</h1>

        <small class="text-muted">
            @Model.Email
        </small>

        <p class="text-muted mt-2 mb-0">
            View the feedback submitted for your courses.
        </p>
    </div>
</div>


@* Display any validation or loading errors *@
<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


@* Show a message when the lecturer has no assigned courses *@
@if (Model.Courses.Count == 0)
{
    <div class="alert alert-light border">
        You do not have any courses assigned yet.
    </div>
}
else
{
    @* Display all courses assigned to the lecturer *@
    <div class="row">

        @* Create one card for each course *@
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card course-card h-100">

                    <div class="card-body">

                        @* Display the course code *@
                        <h4>
                            @course.CourseCode
                        </h4>

                        @* Display the course name *@
                        <p class="text-muted">
                            @course.CourseName
                        </p>

                        @* Open the feedback page for this course *@
                        <a asp-controller="Lecturer" asp-action="Feedback" asp-route-courseCode="@course.CourseCode" class="btn btn-primary">View Feedback</a>

                    </div>

                </div>

            </div>
        }

    </div>
}