@model List<ProfDropMVC.Models.FeedbackViewModel>

@{
    ViewData["Title"] = "Course Feedback";
    string courseCode = ViewBag.CourseCode;
    string selectedCategory = ViewBag.SelectedCategory ?? "All";
}

<div class="container mt-5 mb-5">

    @* Go back to the lecturer dashboard. *@
    <div class="mb-3">
        <a asp-controller="Lecturer" asp-action="Dashboard" class="text-decoration-none">← Back to Dashboard</a>
    </div>

    @* Display the course heading and feedback count. *@
    <div class="mb-4">
        <h1>@courseCode Feedback</h1>
        <p class="text-muted">@Model.Count feedback entr@(Model.Count == 1 ? "y" : "ies")</p>
    </div>


    @* Display any errors returned by the controller. *@
    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    @* Filter the feedback by category. *@
    <form asp-controller="Lecturer" asp-action="Feedback" method="get" class="mb-4">
        @* Keep the selected course when filtering. *@
        <input type="hidden" name="courseCode" value="@courseCode" />
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Filter by Category</label>
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedCategory == "All")">All Categories</option>
                    <option value="Lecture Pace" selected="@(selectedCategory == "Lecture Pace")">Lecture Pace</option>
                    <option value="Explanation" selected="@(selectedCategory == "Explanation")">Explanation</option>
                    <option value="Course Material" selected="@(selectedCategory == "Course Material")">Course Material</option>
                    <option value="Assessment" selected="@(selectedCategory == "Assessment")">Assessment</option>
                    <option value="Other" selected="@(selectedCategory == "Other")"> Other</option>
                </select>
            </div>
        </div>
    </form>


    @* Show a message when there is no feedback. *@
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">
            No feedback has been submitted for this category yet.
        </div>
    }
    else
    {
        @* Display each feedback entry in a card. *@
        @foreach (var feedback in Model)
        {
            <div class="card feedback-card mb-3">

                <div class="card-body">

                    @* Display the category and submission date. *@
                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <strong>@feedback.Category</strong>

                        @if (feedback.SubmittedAt.HasValue)
                        {
                            <small class="text-muted">
                                @(feedback.SubmittedAt.Value.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, h:mm tt"))
                            </small>
                        }

                    </div>

                    @* Display the feedback message. *@
                    <p class="mb-0">
                        @feedback.Message
                    </p>

                </div>

            </div>
        }
    }
